# Example configuration for simple-single-az deployment
# Copy this file to terraform.tfvars and customize values

# Required: Azure subscription ID
subscription_id = "your-subscription-id-here"

# Required: Enforza company ID for agent installation
enforza_companyId = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional: Azure region (defaults to uksouth)
location = "uksouth"

# Optional: Resource group name (defaults to enforza-simple-gateway)
resource_group_name = "enforza-simple-gateway"

# Required: Choose ONE authentication method
# Option 1: Password authentication (minimum 12 characters)
admin_password = "YourSecurePassword123!"

# Option 2: SSH key authentication (preferred)
# ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-public-key-here"

# Optional: VM administrator username (defaults to azureuser)
admin_username = "azureuser"

# Optional: VM size (defaults to Standard_B1s - small/cheap)
# Other options: Standard_B2s, Standard_D2s_v3, etc.
vm_size = "Standard_B1s"

# Optional: Network configuration (defaults shown)
vnet_address_space = ["10.0.0.0/16"]
public_subnet_prefix = "10.0.1.0/24"
private_subnet_1_prefix = "10.0.10.0/24" 
private_subnet_2_prefix = "10.0.20.0/24"